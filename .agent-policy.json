{
  "verify": [
    { "name": "lint", "run": "node bin/boardsmith.js lint" },
    { "name": "audit", "run": "node bin/boardsmith.js audit --dupes-baseline --health-baseline --duplication" },
    { "name": "test", "run": "node bin/boardsmith.js test --verdict-file {verdictFile}", "verdictFile": true },
    { "name": "browser", "run": "node bin/boardsmith.js test --browser" },
    { "name": "catalogue", "run": "node bin/boardsmith.js catalogue --skip 'WindupWarfare=validate does not finish (Shufflewick/WindupWarfare#100)' --skip 'checkers=BoardSmith #552: learnerSeat migration on checkers codex/bs552-tutorial-learner-seat, lands right after' --skip 'go-fish=BoardSmith #552: learnerSeat migration on go-fish codex/bs552-tutorial-learner-seat, lands right after'" }
  ],
  "thread": {
    "workspaces": [
      { "dir": ".", "install": "npm install", "requireInstalled": "node_modules", "refreshWhenChanged": "^package(-lock)?\\.json$" }
    ],
    "seed": [".env", ".env.local", ".dev.vars"],
    "disposableIgnored": [
      "node_modules/",
      "dist/",
      "*.tsbuildinfo",
      "coverage/",
      ".wrangler/",
      ".fallow/*.bin",
      ".fallow/cache/",
      ".fallow/.gitignore",
      "boardsmith-audit-report*.html",
      ".treeshake-test-fixtures/",
      "*.timestamp-*.mjs",
      "*.log"
    ]
  },
  "approval": { "auth": [] }
}
