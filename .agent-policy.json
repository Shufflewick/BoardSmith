{
  "verify": [
    { "name": "audit", "run": "node bin/boardsmith.js audit --dupes-baseline --health-baseline" },
    { "name": "test", "run": "node bin/boardsmith.js test --verdict-file {verdictFile}", "verdictFile": true },
    { "name": "catalogue", "run": "node bin/boardsmith.js catalogue --skip 'WindupWarfare=validate does not finish (Shufflewick/WindupWarfare#100)'" }
  ],
  "thread": {
    "workspaces": [
      { "dir": ".", "install": "npm install", "requireInstalled": "node_modules", "refreshWhenChanged": "^package(-lock)?\\.json$" }
    ],
    "seed": [".env", ".env.local", ".dev.vars"],
    "disposableIgnored": [
      "node_modules/",
      "dist/",
      "*.tsbuildinfo",
      "coverage/",
      ".wrangler/",
      ".fallow/*.bin",
      ".fallow/cache/",
      ".fallow/.gitignore",
      "boardsmith-audit-report*.html",
      ".treeshake-test-fixtures/",
      "*.timestamp-*.mjs",
      "*.log"
    ]
  }
}
