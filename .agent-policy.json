{
  "verify": [
    { "name": "lint", "run": "node bin/boardsmith.js lint" },
    { "name": "audit", "run": "node bin/boardsmith.js audit --dupes-baseline --health-baseline --duplication" },
    { "name": "test", "run": "node bin/boardsmith.js test --verdict-file {verdictFile}", "verdictFile": true },
    { "name": "browser", "run": "node bin/boardsmith.js test --browser" },
    { "name": "catalogue", "run": "node bin/boardsmith.js catalogue --skip 'WindupWarfare=validate does not finish (Shufflewick/WindupWarfare#100)' --skip 'sotf=its harness follows #789 on a branch that waits on its quest-forgery question (Shufflewick/sotf#75)'" }
  ],
  "focused": {
    "selection": ".agent-policy-tests.json",
    "fullEvery": 5,
    "verify": [
      { "name": "authored-tests", "run": "node bin/boardsmith.js test --selection .agent-policy-tests.json" }
    ]
  },
  "thread": {
    "push": "origin",
    "workspaces": [
      { "dir": ".", "install": "npm install", "requireInstalled": "node_modules", "refreshWhenChanged": "^package(-lock)?\\.json$" }
    ],
    "seed": [".env", ".env.local", ".dev.vars"],
    "disposableIgnored": [
      "node_modules/",
      "dist/",
      "*.tsbuildinfo",
      "coverage/",
      ".wrangler/",
      ".fallow/*.bin",
      ".fallow/cache/",
      ".fallow/.gitignore",
      "boardsmith-audit-report*.html",
      ".treeshake-test-fixtures/",
      "*.timestamp-*.mjs",
      "*.log"
    ]
  },
  "approval": { "auth": [] }
}
