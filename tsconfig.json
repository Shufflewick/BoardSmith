{
  // THE ONE TYPECHECK CONFIG. `boardsmith typecheck` runs `vue-tsc --noEmit`
  // against it, `boardsmith test` runs that before any test here, and
  // scripts/merge-branch.sh refuses a branch it fails on. See docs/typecheck.md.
  //
  // The options are a game's options (compare `generateTsConfig` in
  // src/cli/lib/project-scaffold.ts). This package ships TypeScript SOURCE --
  // `exports` maps `types` and `import` straight at `src/**/*.ts` -- so a game's
  // own `vue-tsc` compiles these files under its settings, and an error here is
  // an error in every game. `node` is listed because the CLI and the tests use
  // Node globals ambiently; a game does not, and nothing a game imports may.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "noEmit": true
  },
  // The whole package: every `.ts` and `.vue` under src/ (tests included), the
  // documentation tests, and the vitest config. `vue-tsc` checks `.vue` SFC
  // scripts AND templates; plain `tsc` sees neither.
  "include": ["src/**/*.ts", "src/**/*.vue", "docs/**/*.ts", "vitest.config.ts"],
  // These four tests import `@boardsmith/checkers-rules` and
  // `@boardsmith/cribbage-rules`, which are not in this repository, so they
  // can neither compile nor run. vitest.config.ts excludes the same four.
  "exclude": [
    "node_modules",
    "src/bot/mcts-bot.test.ts",
    "src/bot/mcts-cache.test.ts",
    "src/bot/mcts-stats-checkers.test.ts",
    "src/bot/cribbage-bot.test.ts"
  ]
}
